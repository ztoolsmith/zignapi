{
  "name": "zignapi",
  "version": "0.4.0",
  "description": "CLI pour scaffolder et builder des addons Node.js natifs écrits en Zig (commande `zignapi`)",
  "keywords": ["zig", "napi", "node-api", "native", "addon", "zignapi"],
  "type": "module",
  "bin": {
    "zignapi": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "zig build && tsc",
    "build:zig": "zig build",
    "build:ts": "tsc",
    "test": "zig build test"
  },
  "license": "MIT"
}
